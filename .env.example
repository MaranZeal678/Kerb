# LLM endpoint - any OpenAI-compatible API (/chat/completions, /embeddings).
# Leave unset to run fully offline: retrieval falls back to lexical scoring and
# plan compilation falls back to the deterministic compiler.
KERB_LLM_BASE_URL=
KERB_LLM_API_KEY=
KERB_LLM_MODEL=
KERB_EMBED_MODEL=

# Where the app is reachable. The sandbox runner drives this URL.
KERB_BASE_URL=http://localhost:3100

# Optional: isolated sandbox provider for verification runs.
# Unset uses the local headless-browser sandbox.
SANDBOX_API_KEY=

# Optional: force the deterministic compiler even when an endpoint is set.
KERB_FORCE_DETERMINISTIC=
